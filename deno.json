{
  "name": "@invoice-passport/core",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --no-lock --allow-read --allow-net=127.0.0.1,localhost",
    "check": "deno check mod.ts cli/verify.ts scripts/gen-vectors.ts",
    "vectors": "deno run --allow-read --allow-write scripts/gen-vectors.ts",
    "verify": "deno run --allow-read --allow-net cli/verify.ts",
    "bundle": "deno bundle --platform browser --format esm -o web/invoice-passport.js mod.ts",
    "conformance": "./conformance/run.sh"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "vectors/",
      "web/invoice-passport.js",
      "conformance/.cache/"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    },
    "exclude": [
      "web/invoice-passport.js",
      "conformance/.cache/"
    ]
  },
  "lock": false,
  "imports": {
    "viem": "npm:viem@2.21.0",
    "viem/accounts": "npm:viem@2.21.0/accounts",
    "pdf-lib": "npm:pdf-lib@1.17.1",
    "@pdf-lib/fontkit": "npm:@pdf-lib/fontkit@1.1.1"
  }
}
